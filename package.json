{
  "name": "surfcore",
  "version": "0.8.9-dev.6",
  "private": true,
  "license": "MIT",
  "description": "SurfCore: clean kernel + frozen runtime adapter + one-package host/UI.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./ui": "./ui/index.js",
    "./ui/client": "./ui/client.js",
    "./locale/*.json": "./ui/locale/*.json",
    "./icon": "./ui/icon.svg"
  },
  "scripts": {
    "start": "node index.js",
    "test:arch": "node tools/run-all.mjs",
    "build:ui": "node ui/build.mjs --root . && node -e \"const fs=require('fs');fs.copyFileSync('ui/client.js','client.js')\"",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "kernel",
    "runtime",
    "packs",
    "ui/client.js",
    "ui/client.template.js",
    "ui/index.js",
    "ui/build.mjs",
    "ui/package.json",
    "ui/locale",
    "ui/art",
    "ui/icon.svg",
    "ui/src",
    "ui/docs",
    "tools",
    "docs"
  ]
}
